{
  "name": "persona16",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix apps/web run build:cloudflare && npm --prefix apps/web run bundle:cloudflare && node scripts/prepare-sites-build.mjs",
    "test": "pnpm --filter @persona16/eval unit",
    "typecheck": "pnpm -r typecheck",
    "eval:blindtest": "pnpm --filter @persona16/eval blindtest",
    "eval:dynamics": "pnpm --filter @persona16/eval dynamics",
    "eval:pilot-characters": "pnpm --filter @persona16/eval pilot:characters",
    "eval:pilot-model-compare": "pnpm --filter @persona16/eval pilot:compare-models",
    "eval:rooms": "pnpm --filter @persona16/eval rooms",
    "eval:room-adversarial": "pnpm --filter @persona16/eval room:adversarial",
    "eval:safety": "pnpm --filter @persona16/eval safety",
    "eval:phase4-smoke": "pnpm --filter @persona16/eval phase4:smoke",
    "eval:runtime": "pnpm --filter @persona16/eval runtime:compare",
    "eval:trust-balance": "pnpm --filter @persona16/eval trust:balance",
    "eval:trust-suite": "pnpm --filter @persona16/eval trust:suite",
    "eval:report": "pnpm --filter @persona16/eval report"
  },
  "packageManager": "pnpm@11.11.0"
}
