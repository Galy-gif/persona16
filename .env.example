# ===== 模型提供商 =====
# 可显式选择 aihubmix、deepseek 或 anthropic。未设置时，有 DEEPSEEK_API_KEY 就走 DeepSeek，否则走 Anthropic。
# AIHubMix 使用 OpenAI 兼容接口；密钥只写本地 .env，不提交仓库。
# AIHUBMIX_API_KEY=
# AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# PERSONA16_PROVIDER=aihubmix

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PERSONA16_PROVIDER=deepseek

# 用 Anthropic 时填这个
# ANTHROPIC_API_KEY=

# ===== 可选：覆盖默认模型 =====
# aihubmix 默认：普通陪伴/分析=gpt-5.6-luna，结构化控制=deepseek-v4-flash，评审=deepseek-v4-pro。
# deepseek 默认三个角色都用 deepseek-v4-pro；anthropic 默认 agent=claude-sonnet-5 / director=claude-haiku-4-5。
# PERSONA16_AGENT_MODEL=gpt-5.6-luna
# PERSONA16_ANALYSIS_MODEL=gpt-5.6-luna
# PERSONA16_DIRECTOR_MODEL=deepseek-v4-flash
# PERSONA16_JUDGE_MODEL=deepseek-v4-pro

# ===== 可选：切换 Agent 发言执行层 =====
# AIHubMix、DeepSeek 与 Anthropic 默认都使用 @persona16/runtime-pi；需要回滚时设为 legacy。
# 导演/评审结构化 JSON 暂仍走 legacy adapter。
# PERSONA16_RUNTIME=legacy

# ===== 可选：引擎 trace 落盘路径 =====
# PERSONA16_TRACE_FILE=traces/engine.jsonl

# ===== Phase 4：服务端状态 =====
# 生产环境必须使用 PostgreSQL；本地未设置时 Web 会使用进程内临时 Store。
# DATABASE_URL=postgresql://persona16:persona16@localhost:5432/persona16
# PERSONA16_SESSION_SECRET=replace-with-at-least-32-random-characters
# 每次部署设置为 commit SHA 或构建号，用于按版本切分运行指标。
# PERSONA16_BUILD_VERSION=development
# 仅允许单机临时部署显式启用；多实例不要使用。
# PERSONA16_ALLOW_MEMORY_STORE=0
# 仅当部署平台会覆盖/清洗 x-forwarded-for 时启用。
# PERSONA16_TRUST_PROXY=1
